# AgroSense Environment Configuration Example
# Copy this file to .env and configure your values

# Secret key for JWT token hashing (replace with a 256-bit secure key in production)
SECRET_KEY=agrosense_production_secret_key_change_me_before_deploying

# Database Connection URL:
# Defaults to local SQLite for zero-setup local operation:
DATABASE_URL=sqlite:///./agrosense.db

# Or use PostgreSQL / Supabase connection string:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# API Environment
ENV=development
API_PORT=8000
FRONTEND_PORT=5173
